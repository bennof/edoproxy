[Unit]
Description=edoproxy local CORS proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/edoproxy --config %h/.config/edoproxy/config.toml
Environment=RUST_LOG=edoproxy=info
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
